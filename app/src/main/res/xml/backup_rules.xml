<?xml version="1.0" encoding="utf-8"?><!--
   자동 백업 규칙(API 30 이하 대상: android:fullBackupContent).
   인증 토큰은 EncryptedSharedPreferences로 저장되며, 암호화 마스터 키는 Keystore에 있어
   다른 기기로 복원해도 복호화가 불가능하다(복원 시 크래시 위험). 따라서 백업에서 제외한다.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="fixlog_auth.xml" />
    <exclude domain="sharedpref" path="fixlog_workspace.xml" />
</full-backup-content>
