<?xml version="1.0" encoding="utf-8"?><!--
   데이터 추출 규칙(API 31+ 대상: android:dataExtractionRules).
   클라우드 백업 및 기기 간 전송 모두에서 인증 토큰 저장소를 제외한다.
   (EncryptedSharedPreferences는 Keystore 기반이라 타 기기 복원 시 복호화 불가)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="fixlog_auth.xml" />
        <exclude domain="sharedpref" path="fixlog_workspace.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="fixlog_auth.xml" />
        <exclude domain="sharedpref" path="fixlog_workspace.xml" />
    </device-transfer>
</data-extraction-rules>
