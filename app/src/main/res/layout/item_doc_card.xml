<?xml version="1.0" encoding="utf-8"?>
<!-- 재사용 문서 행: 아이콘 + 제목/설명/상태·작성자. 텍스트/상태색은 코드에서 채운다(목업). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="top"
    android:paddingVertical="12dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/doc_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_doc_icon"
        android:padding="10dp"
        android:src="@drawable/ic_file"
        android:contentDescription="document" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/doc_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Document title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/editor_title"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/doc_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Description"
            android:textSize="14sp"
            android:textColor="@color/editor_meta"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/doc_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_published"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="Published"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/published_text" />

            <TextView
                android:id="@+id/doc_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Author · Date"
                android:textSize="12sp"
                android:textColor="@color/editor_meta"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>