<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/editor_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 상단 제목 + 필터 버튼 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <!-- 제목. 선택 모드에서는 "N개 선택됨"으로 바뀐다. -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/nav_docs"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/editor_title" />

            <ImageView
                android:id="@+id/btn_filter"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_filter"
                android:scaleType="fitCenter"
                android:contentDescription="@string/docs_filter"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/editor_meta"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageView
                android:id="@+id/btn_add"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_plus"
                android:scaleType="fitCenter"
                android:contentDescription="@string/create_new"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/editor_blue"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- 제목 검색(폴더명 + 문서 제목, 워크스페이스 전체). 입력 중에는 검색 결과만 보인다. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search_box"
            android:paddingStart="12dp"
            android:paddingEnd="4dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                android:importantForAccessibility="no" />

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="@string/docs_search_hint"
                android:textSize="15sp"
                android:textColor="@color/editor_title"
                android:textColorHint="@color/editor_meta"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:maxLines="1"
                android:importantForAutofill="no" />

            <ImageView
                android:id="@+id/btn_clear_search"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="9dp"
                android:src="@drawable/ic_close"
                android:scaleType="fitCenter"
                android:contentDescription="@string/docs_search_clear"
                android:visibility="gone"
                app:tint="@color/editor_meta"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- 현재 경로(breadcrumb): 코드에서 세그먼트를 채운다. 각 세그먼트 클릭 시 해당 위치로 이동. -->
        <HorizontalScrollView
            android:id="@+id/breadcrumb_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/breadcrumb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/editor_divider" />

        <!-- 아래로 당겨 새로고침. 리스트 스크롤 여부는 코드에서 RecyclerView 기준으로 판단한다. -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 트리 구조 리스트 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_browser"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="96dp" />

            <!-- 검색 결과 없음 -->
            <TextView
                android:id="@+id/tv_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/docs_search_empty"
                android:textColor="@color/editor_meta"
                android:textSize="14sp"
                android:gravity="center"
                android:paddingVertical="40dp"
                android:visibility="gone" />

            <!-- 로딩 중 skeleton. 소유자 해석(enrich)까지 끝나면 숨기고 실제 리스트를 보여준다. -->
            <LinearLayout
                android:id="@+id/ll_skeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <include layout="@layout/item_skeleton" />
                <include layout="@layout/item_skeleton" />
                <include layout="@layout/item_skeleton" />
                <include layout="@layout/item_skeleton" />
                <include layout="@layout/item_skeleton" />
                <include layout="@layout/item_skeleton" />
            </LinearLayout>
        </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <include
        android:id="@+id/bottom_nav"
        layout="@layout/view_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp" />

    <!-- 다중 선택 기능바: 선택 모드에서 하단 네비 자리에 대신 보인다. -->
    <LinearLayout
        android:id="@+id/bulk_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_bottom_nav"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/btn_bulk_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_check"
                app:tint="@color/editor_meta"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/docs_select_all"
                android:textSize="10sp"
                android:textColor="@color/editor_meta" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_bulk_move"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_folder_move"
                app:tint="@color/editor_meta"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/common_move"
                android:textSize="10sp"
                android:textColor="@color/editor_meta" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_bulk_download"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_import"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/actions_download"
                android:textSize="10sp"
                android:textColor="@color/editor_meta" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_bulk_delete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_trash"
                app:tint="#DC2626"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/common_delete"
                android:textSize="10sp"
                android:textColor="@color/editor_meta" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_bulk_close"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_close"
                app:tint="@color/editor_meta"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/docs_select_done"
                android:textSize="10sp"
                android:textColor="@color/editor_meta" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
