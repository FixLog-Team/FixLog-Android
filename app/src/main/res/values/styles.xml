<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 공유 탭 텍스트: 대문자 변환 없이 앱 톤에 맞춘 볼드 14sp. -->
    <style name="TextAppearance.FixLog.Tab" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ===== 공용 버튼 스타일(앱 UI 통일): 12dp 라운드, 비대문자, 15sp ===== -->
    <!-- 기본 채움 버튼(파란 primary). -->
    <style name="Widget.FixLog.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="backgroundTint">@color/editor_blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- 보조(아웃라인) 버튼: 흰 배경 + 회색 테두리. -->
    <style name="Widget.FixLog.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/editor_title</item>
        <item name="strokeColor">@color/card_border</item>
        <item name="iconTint">@color/editor_meta</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- 위험(삭제/나가기/로그아웃) 버튼: 흰 배경 + 빨간 테두리/텍스트. -->
    <style name="Widget.FixLog.Button.Danger" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">#DC2626</item>
        <item name="strokeColor">#F1C7C7</item>
        <item name="iconTint">#DC2626</item>
        <item name="iconGravity">textStart</item>
    </style>


    <!-- 홈 추천 프롬프트 칩 -->
    <style name="HomeChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/editor_title</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 홈 빠른 동작 카드 -->
    <style name="QuickCard">
        <item name="android:layout_width">150dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card_white</item>
        <item name="android:padding">14dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="QuickCardIcon">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">@drawable/bg_icon_blue</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="QuickCardLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/editor_title</item>
    </style>

    <!-- "전체" 다이얼로그 그리드 셀 -->
    <style name="AllCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="AllCellIcon">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_icon_blue</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="AllCellLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/editor_title</item>
    </style>

    <!-- AI 검색 결과 태그 칩 -->
    <style name="TagChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/bg_tag</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/editor_meta</item>
    </style>

    <!-- 문서 리스트 행 구분선 -->
    <style name="RowDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/editor_divider</item>
    </style>

    <!-- AI 검색 예시 프롬프트(평문) -->
    <style name="SearchExample">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/editor_meta</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <!-- AI 검색 후속질문 칩 -->
    <style name="SearchChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/editor_title</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

</resources>