# 릴리스 업로드 키 설정 템플릿.
# 이 파일을 복사해 루트에 keystore.properties 로 저장하고 실제 값으로 채운다.
#   cp keystore.properties.example keystore.properties
# keystore.properties 와 *.jks/*.keystore 는 .gitignore 로 제외되어 커밋되지 않는다.
#
# 업로드 키 생성(최초 1회):
#   keytool -genkeypair -v -keystore release.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias fixlog
#
# storeFile 은 루트(프로젝트 최상위) 기준 경로.

storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=fixlog
keyPassword=CHANGE_ME
